     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n\"Oximetry\" < 92%\n*/\ndefine \"Should Refer urgently to a hospital 2\":\n  ContactData.\"Oximetry\" < 92 '%'" ]
     ], [

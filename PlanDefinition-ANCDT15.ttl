  fhir:PlanDefinition.description [ fhir:value "Depending on the woman's behaviours reported during the first contact and the woman's reported persistent behaviours, additional counselling may or may not be required "] ;
  fhir:PlanDefinition.useContext [
     fhir:index 0 ;

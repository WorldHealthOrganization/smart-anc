<http://smart.who.int/anc/ImplementationGuide/smart.who.int.anc> a fhir:ImplementationGuide ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "smart.who.int.anc"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide smart.who.int.anc</b></p><a name=\"smart.who.int.anc\"> </a><a name=\"hcsmart.who.int.anc\"> </a><h2>ANCCDS</h2><p>The official URL for this implementation guide is: </p><pre>http://smart.who.int/anc/ImplementationGuide/smart.who.int.anc</pre><div><p>This implementation guide provides implementation resources and guidance in support of applying the <a href=\"https://www.who.int/reproductivehealth/publications/maternal_perinatal_health/anc-positive-pregnancy-experience/en/\">WHO recommendations on antenatal care for a positive pregnancy experience</a>.&lt;/br&gt;This implementation guide is part of the WHO Smart Guidelines approach to support countries to integrate WHO global data and health recommendations into digital systems accurately and consistently. This new approach to global health in the digital age beings with maternal health and the launch of the <a href=\"https://www.srhr.org/antenatalcare/\">WHO Smart Antenatal Care Guidelines</a>.</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "http://smart.who.int/anc/ImplementationGuide/smart.who.int.anc"] ;
  fhir:ImplementationGuide.version [ fhir:value "0.3.0"] ;
  fhir:ImplementationGuide.name [ fhir:value "ANCCDS"] ;
  fhir:ImplementationGuide.title [ fhir:value "WHO Antenatal Care Guideline Implementation Guide"] ;
  fhir:ImplementationGuide.status [ fhir:value "draft"] ;
  fhir:ImplementationGuide.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:ImplementationGuide.date [ fhir:value "2017-02-06"^^xsd:date] ;
  fhir:ImplementationGuide.publisher [ fhir:value "World Health Organization (WHO)"] ;
  fhir:ImplementationGuide.contact [
     fhir:index 0 ;
     fhir:ContactDetail.telecom [
       fhir:index 0 ;
       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "https://www.who.int" ]
     ]
  ] ;
  fhir:ImplementationGuide.description [ fhir:value "This implementation guide provides implementation resources and guidance in support of applying the [WHO recommendations on antenatal care for a positive pregnancy experience](https://www.who.int/reproductivehealth/publications/maternal_perinatal_health/anc-positive-pregnancy-experience/en/).</br>This implementation guide is part of the WHO Smart Guidelines approach to support countries to integrate WHO global data and health recommendations into digital systems accurately and consistently. This new approach to global health in the digital age beings with maternal health and the launch of the [WHO Smart Antenatal Care Guidelines](https://www.srhr.org/antenatalcare/)."] ;

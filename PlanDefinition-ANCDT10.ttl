       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Should Conduct hepatitis C test 4" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n\"Occupation\" = \"Informal employment (sex worker)\"\n*/\ndefine \"Should Conduct hepatitis C test 4\":\n  BaseDataElements.\"Patient Occupation\" in Cx.\"Occupation - Informal employment (other) Choices\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "3"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 4 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCContactDataElements" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Current alcohol and/or other substance use" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n  @dataElement: ANC.B6.DE146 Current alcohol and/or other substance use\n  @activity: ANC.B6 Profile\n  @description: Whether or not the woman currently consumes any alcohol or substances\n*/\ndefine \"Current alcohol and/or other substance use\":\n  [Observation: Cx.\"Current alcohol and/or other substance use\"] O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and Coalesce(WC.ModifierExtension(O, 'who-notDone').value, false) is false\n      and Last(Split(O.encounter.reference, '/')) = Last(Split(encounter, '/'))\n    return O.value as FHIR.CodeableConcept" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "4"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 5 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCDT10" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Should Conduct hepatitis C test 3" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n\"Current alcohol and/or other substance use\" = \"Injectable drugs\"\n*/\ndefine \"Should Conduct hepatitis C test 3\":\n  ContactData.\"Current alcohol and/or other substance use\" in Cx.\"Current alcohol and/or other substance use - Injectable drugs Choices\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "5"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 6 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCContactDataElements" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "HIV status" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n  @dataElement: ANC.B9.DE45 HIV status\n  @activity: ANC.B9 Lab tests & imaging\n  @description: Calculated field for woman's HIV status\n*/\ndefine \"HIV status\":\n  WC.Only(\n  [Observation: Cx.\"HIV status\"] O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and Coalesce(WC.ModifierExtension(O, 'who-notDone').value, false) is false\n      and Last(Split(O.encounter.reference, '/')) = Last(Split(encounter, '/'))\n  ).value as FHIR.CodeableConcept" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "6"^^xsd:integer ]
     ] ;

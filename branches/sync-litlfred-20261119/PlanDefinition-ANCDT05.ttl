  ], [
     fhir:index 8 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "FHIRHelpers" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ToBoolean" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function ToBoolean(value boolean): value.value" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "8"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 9 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "WHOCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ModifierExtension" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n@description: Returns the single WHO core modifier extension (if present) on the given resource with the specified id.\n@comment: This function uses singleton from to ensure that a run-time exception is thrown if there\nis more than one extension on the given resource with the specified url.\n*/\ndefine function ModifierExtension(domainResource DomainResource, id String):\n  singleton from ModifierExtensions(domainResource, id)" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "9"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 10 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "WHOCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ModifierExtensions" ]
     ], [

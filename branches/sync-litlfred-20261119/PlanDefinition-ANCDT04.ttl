  fhir:PlanDefinition.action [
     fhir:index 0 ;
     fhir:PlanDefinition.action.title [ fhir:value "ANC.DT.04 Conducting physical exams" ] ;
     fhir:PlanDefinition.action.trigger [
       fhir:index 0 ;
       fhir:TriggerDefinition.type [ fhir:value "named-event" ] ;
       fhir:TriggerDefinition.name [ fhir:value "ANC.B8 Conduct physical exam" ]
     ] ;
     fhir:PlanDefinition.action.action [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "1" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Measure BP again after 10–15 minutes rest" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Measure BP again after 10–15 minutes rest" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Given high values (SBP ≥ 140 or DBP ≥ 90) upon first measure, blood pressure should be measured again" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-51 (5)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "(\"Systolic blood pressure\" ≥ 140 mmHg)\n  OR (\"Diastolic blood pressure\" ≥ 90 mmHg)" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Measure BP again after 10–15 minutes rest" ]
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "2" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Measure temperature again" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Measure temperature again" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "The health worker should retake the woman's temperature if the first reading is over 38°C" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-113 (5)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Body temperature\" ≥ 38°C" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Measure temperature again" ]
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "3" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Check again after 10 minutes rest" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Check again after 10 minutes rest" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "The health worker should retake the woman's pulse rate if the first reading is lower than 60 or higher than 100 beats per minute" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-1 (5)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "60 > Pulse rate > 100" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Check again after 10 minutes rest" ]
         ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "4" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct oximetry test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct oximetry test" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "If the woman has an abnormal respiratory exam result or respiratory distress, conduct oximetry test" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-149 (5)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "((((((\"Respiratory exam result\" = \"Dyspnoea\")\n  OR (\"Respiratory exam result\" = \"Cough\"))\n  OR (\"Respiratory exam result\" = \"Rapid breathing\"))\n  OR (\"Respiratory exam result\" = \"Slow breathing\"))\n  OR (\"Respiratory exam result\" = \"Wheezing\"))\n  OR (\"Respiratory exam result\" = \"Rales\"))\n  OR (\"Respiratory exam result\" = \"Other abnormal respiratory exam result (specify)\")" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct oximetry test" ]
         ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "5" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Measure the fetal heart rate again" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Measure the fetal heart rate again" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Fetal heart rate out of normal range (100–180) – please have the woman lay on her left side for 15 minutes and check again" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): C-89 (5)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "100 bpm > Fetal heart rate > 180 bpm" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Measure the fetal heart rate again" ]
         ]
       ]
     ]
  ] .


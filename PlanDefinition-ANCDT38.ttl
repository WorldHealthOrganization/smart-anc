  fhir:PlanDefinition.action [
     fhir:index 0 ;
     fhir:PlanDefinition.action.title [ fhir:value "ANC.DT.38 Deworming and malaria prophylaxis" ] ;
     fhir:PlanDefinition.action.trigger [
       fhir:index 0 ;
       fhir:TriggerDefinition.type [ fhir:value "named-event" ] ;
       fhir:TriggerDefinition.name [ fhir:value "ANC.B10. Counselling, in-facility management and treatment" ]
     ] ;
     fhir:PlanDefinition.action.action [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "1" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Provide malaria prophylaxis" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Provide malaria prophylaxis" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Sleeping under an insecticide-treated bednet and the importance of seeking care and getting treatment as soon as she has any symptoms" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): C.6. Malaria prevention: intermittent preventive treatment in pregnancy (IPTp) (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "Malaria-endemic setting = TRUE" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Provide malaria prophylaxis" ]
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "2" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Do not give IPTp-SP, because woman is taking co-trimoxazole" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Do not give IPTp-SP, because woman is taking co-trimoxazole" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "IF the woman is currently taking co-trimoxazole, even in a malaria-endemic setting, she should not receive any dose of IPTp-SP. Women who are taking co-trimoxazole SHOULD NOT receive IPTp-SP. Taking both co-trimoxazole and IPTp-SP together can enhance side-effects, especially haematological side-effects such as anaemia." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): C.6. Malaria prevention: intermittent preventive treatment in pregnancy (IPTp) (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "(Malaria-endemic setting = TRUE)\n  AND (Current medications\" = \"Co-trimoxazole\")" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Do not give IPTp-SP, because woman is taking co-trimoxazole" ]
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "3" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct deworming" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct deworming" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "In areas with a population prevalence of infection with any soil-transmitted helminths of 20% or higher OR a population anaemia prevalence 40% or higher, preventive anthelminthic treatment is recommended for pregnant women after the first trimester as part of worm infection reduction programmes" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): C.4. Preventive anthelminthic treatment (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "(\"Population prevalence of soil-transmitted helminth infection\" ≥ 20% )\n  OR (\"Population prevalence of anaemia\" ≥ 40%)" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct deworming" ]
         ]
       ]
     ]
  ] .


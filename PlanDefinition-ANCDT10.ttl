  fhir:PlanDefinition.action [
     fhir:index 0 ;
     fhir:PlanDefinition.action.title [ fhir:value "ANC.DT.10 Hepatitis C testing" ] ;
     fhir:PlanDefinition.action.trigger [
       fhir:index 0 ;
       fhir:TriggerDefinition.type [ fhir:value "named-event" ] ;
       fhir:TriggerDefinition.name [ fhir:value "ANC.B9. Conduct laboratory tests and imaging" ]
     ] ;
     fhir:PlanDefinition.action.action [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "1" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct hepatitis C test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct hepatitis C test" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "In settings where the proportion of HCV antibody seroprevalence in the general population is 2% or higher, then a hepatitis C test is required.\n\nAnti-HCV laboratory-based immunoassay is the preferred method for testing for Hep C infection in pregnancy; if immunoassay is not available, anti-HCV rapid diagnostic test (RDT) is recommended over dried blood spot (DBS) anti-HCV testing." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Guidelines on hepatitis B and C testing (2017): Recommendation 6.1 (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Population prevalence of hepatitis C\" ≥ 2%" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct hepatitis C test" ]
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "2" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct hepatitis C test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct hepatitis C test 2" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "If the woman is HIV positive, then a hepatitis C test is required.\n\nAnti-HCV laboratory-based immunoassay is the preferred method for testing for Hep C infection in pregnancy; if immunoassay is not available, anti-HCV rapid diagnostic test (RDT) is recommended over dried blood spot (DBS) anti-HCV testing" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Guidelines on hepatitis B and C testing (2017): Recommendation 6.1 (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"HIV status\" = \"HIV positive\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct hepatitis C test 2" ]
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "3" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct hepatitis C test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct hepatitis C test 3" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "If the woman injects drugs, then a hepatitis C test is required.\n\nAnti-HCV laboratory-based immunoassay is the preferred method for testing for Hep C infection in pregnancy; if immunoassay is not available, anti-HCV rapid diagnostic test (RDT) is recommended over dried blood spot (DBS) anti-HCV testing." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Guidelines on hepatitis B and C testing (2017): Recommendation 6.1 (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current alcohol and/or other substance use\" = \"Injectable drugs\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct hepatitis C test 3" ]
         ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "4" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct hepatitis C test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct hepatitis C test 4" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "If a woman is a sex worker, then a hepatitis C test is required.\n\nAnti-HCV laboratory-based immunoassay is the preferred method for testing for Hep C infection in pregnancy; if immunoassay is not available, anti-HCV rapid diagnostic test (RDT) is recommended over dried blood spot (DBS) anti-HCV testing." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Guidelines on hepatitis B and C testing (2017): Recommendation 6.1 (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Occupation\" = \"Informal employment (sex worker)\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct hepatitis C test 4" ]
         ]
       ]
     ]
  ] .


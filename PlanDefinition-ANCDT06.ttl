       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Should Refer to a hospital 4" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n(100 bpm > \"Second fetal heart rate\" > 180 bpm)\n  AND (\"Gestational age\" ≥ 20 weeks)\n*/\ndefine \"Should Refer to a hospital 4\":\n  (ContactData.\"Second fetal heart rate\" < 100\n    or ContactData.\"Second fetal heart rate\" > 180)\n    and ContactData.\"Gestational age\" >= 20 'weeks'" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "19"^^xsd:integer ]

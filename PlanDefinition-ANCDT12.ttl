  fhir:PlanDefinition.action [
     fhir:index 0 ;
     fhir:PlanDefinition.action.title [ fhir:value "ANC.DT.12 Urine testing" ] ;
     fhir:PlanDefinition.action.trigger [
       fhir:index 0 ;
       fhir:TriggerDefinition.type [ fhir:value "named-event" ] ;
       fhir:TriggerDefinition.name [ fhir:value "ANC.B9. Conduct laboratory tests and imaging" ]
     ] ;
     fhir:PlanDefinition.action.action [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "1" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct urine test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct urine test" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Urine test is required any time the woman reports pain during urination (dysuria)" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-51 (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current physiological symptoms\" = \"Pain during urination (dysuria)\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct urine test" ]
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "2" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Do urine dipstick test for protein" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Do urine dipstick test for protein" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Given high values (SBP ≥ 140 or DBP ≥ 90) upon second measure, urine dipstick test should be done to check for protein in the urine, a symptom of pre-eclampsia" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): Section S-51 (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "(\"Repeat systolic blood pressure\" ≥ 140 mmHg)\n  OR (\"Repeat diastolic blood pressure\" ≥ 90mmHg)" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Do urine dipstick test for protein" ]
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "3" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct urine test" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct urine test 2" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "The urine test checks for bacterial or other infections that can lead to adverse outcomes for the neonate. The urine dipstick test can check for proteins in the urine, which can be a sign of pre-eclampsia. Midstream urine culture is the preferred method for testing for asymptomatic bacteriuria (ASB) in pregnancy; if culture is not available, midstream urine Gram-staining is recommended over dipstick.\n\nUrine dipstick tests should only be used to diagnose ASB in pregnancy if midstream culture and Gram-staining are not possible. Dipstick tests are required to check for protein in the urine, a symptom of pre-eclampsia." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): B.1.2. Asymptomatic bacteriuria (ASB) (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "((\"ANC contact number\" = 1)\n  OR (\"Gestational age\" ≥ 26 weeks))\n  OR (\"Gestational age\" ≥ 34 weeks)" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct urine test 2" ]
         ]
       ]
     ]
  ] .


  fhir:PlanDefinition.action [
     fhir:index 0 ;
     fhir:PlanDefinition.action.title [ fhir:value "ANC.DT.03 Check symptoms and follow up" ] ;
     fhir:PlanDefinition.action.trigger [
       fhir:index 0 ;
       fhir:TriggerDefinition.type [ fhir:value "named-event" ] ;
       fhir:TriggerDefinition.name [ fhir:value "ANC.B7 Check symptoms and follow up" ]
     ] ;
     fhir:PlanDefinition.action.action [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "1" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Ginger, chamomile, vitamin B6 and/or acupuncture are recommended for the relief of nausea in early pregnancy, depending on a woman’s preferences and available options. Women should be informed that symptoms of nausea and vomiting usually resolve in the second half of pregnancy." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.1. Nausea and vomiting (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current physiological symptoms\" = \"Nausea and vomiting\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ]
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "2" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 2" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Pharmacological treatments for nausea and vomiting, such as doxylamine and metoclopramide, should be reserved for those pregnant women experiencing distressing symptoms that are not relieved by non-pharmacological options, under the supervision of a medical doctor" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.1. Nausea and vomiting (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Persistent physiological symptoms\" = \"Nausea and vomiting\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 2" ]
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "3" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 3" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Advice on diet and lifestyle is recommended to prevent and relieve heartburn in pregnancy. Antacid preparations can be offered to women with troublesome symptoms that are not relieved by lifestyle modification." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.2. Heartburn (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current physiological symptoms\" = \"Heartburn\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 3" ]
         ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "4" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 4" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Antacid preparations can be offered to women with troublesome symptoms that are not relieved by lifestyle modification. Magnesium carbonate and aluminium hydroxide preparations are probably unlikely to cause harm in recommended dosages." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.2. Heartburn (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Persistent physiological symptoms\" = \"Heartburn\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 4" ]
         ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "5" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 5" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Non-pharmacological therapies, including muscle stretching, relaxation, heat therapy, dorsiflexion of the foot, and massage can be used for the relief of leg cramps in pregnancy" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.3. Leg cramps (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current physiological symptoms\" = \"Leg cramps\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 5" ]
         ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "6" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 6" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "If leg cramps are not relieved with non-pharmacological measures, then give 300–360 mg magnesium per day in two or three divided doses; give calcium 1 g twice daily for two weeks" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.3. Leg cramps (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Persistent physiological symptoms\" = \"Leg cramps\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 6" ]
         ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "7" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Regular exercise throughout pregnancy is recommended to prevent low back and pelvic pain. There are a number of different treatment options that can be used, such as physiotherapy, support belts and acupuncture, depending and based on a woman’s preferences and available options." ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.4. Low back and pelvic pain (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "((((\"Current physiological symptoms\" = \"Low back pain\")\n  AND (Current physiological symptoms\" ≠ \"Contractions\" OR \"Pain during urination (dysuria)\" OR \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\"))\n  OR ((\"Current physiological symptoms\" = \"Pelvic pain\")\n  AND (Current physiological symptoms\" ≠ \"Contractions\" OR \"Pain during urination (dysuria)\" OR \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\")))\n  OR ((\"Persistent physiological symptoms\" = \"Low back pain\")\n  AND (Current physiological symptoms\" ≠ \"Contractions\" OR \"Pain during urination (dysuria)\" OR \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\")))\n  OR ((\"Persistent physiological symptoms\" = \"Pelvic pain\")\n  AND (Current physiological symptoms\" ≠ \"Contractions\" OR \"Pain during urination (dysuria)\" OR \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\"))" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms" ]
         ]
       ] ;
       fhir:PlanDefinition.action.action [
         fhir:index 0 ;
         fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms" ]
       ], [
         fhir:index 1 ;
         fhir:PlanDefinition.action.title [ fhir:value "Counselling on regular exercise, physiotherapy, support belts and acupuncture to relieve low back and pelvic pain" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "8" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 7" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Dietary modifications to relieve constipation include promoting adequate intake of water and dietary fibre (found in vegetables, nuts, fruits and whole grains)" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.5. Constipation (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Current physiological symptoms\" = \"Constipation\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 7" ]
         ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "9" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 8" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Wheat bran or other fibre supplements can be used to relieve constipation, if dietary modifications are not enough, and if they are available and appropriate" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.5. Constipation (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "\"Persistent physiological symptoms\" = \"Constipation\"" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 8" ]
         ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "10" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message)" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms (see Annotations for pop-up message) 9" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Non-pharmacological options, such as compression stockings, leg elevation and water immersion, can be used for the management of varicose veins and oedema in pregnancy, depending and based on a woman’s preferences and available options" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "WHO ANC recommendations (2016): D.6. Varicose veins and oedema (3)\nWHO consolidated self-care interventions guidelines (2019) (4)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "((((\"Current physiological symptoms\" = \"Varicose veins\")\n  AND (Current physiological symptoms\" ≠ \"Leg pain\" OR \"Leg redness\"))\n  OR ((\"Current physiological symptoms\" = \"Oedema\")\n  AND (Current physiological symptoms\" ≠ \"Leg pain\" OR \"Leg redness\")))\n  OR ((\"Persistent physiological symptoms\" = \"Varicose veins\")\n  AND (Current physiological symptoms\" ≠ \"Leg pain\" OR \"Leg redness\")))\n  OR ((\"Persistent physiological symptoms\" = \"Oedema\")\n  AND (Current physiological symptoms\" ≠ \"Leg pain\" OR \"Leg redness\"))" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms (see Annotations for pop-up message) 9" ]
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "11" ] ;
       fhir:PlanDefinition.action.title [ fhir:value "Conduct counselling on physiological symptoms" ] ;
       fhir:PlanDefinition.action.description [ fhir:value "Conduct counselling on physiological symptoms 2" ] ;
       fhir:PlanDefinition.action.textEquivalent [ fhir:value "Please investigate any possible complications or onset of labour, related to low back and pelvic pain" ] ;
       fhir:PlanDefinition.action.documentation [
         fhir:index 0 ;
         fhir:RelatedArtifact.type [ fhir:value "citation" ] ;
         fhir:RelatedArtifact.label [ fhir:value "Managing complications guide (IMPAC) (2017): C-3 (3)" ]
       ] ;
       fhir:PlanDefinition.action.condition [
         fhir:index 0 ;
         fhir:PlanDefinition.action.condition.kind [ fhir:value "applicability" ] ;
         fhir:PlanDefinition.action.condition.expression [
           fhir:Expression.description [ fhir:value "(((\"Current physiological symptoms\" = \"Contractions\")\n  OR (Current physiological symptoms\" = \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\"))\n  OR (\"Persistent physiological symptoms\" = \"Contractions\"))\n  OR (Persistent physiological symptoms\" = \"Extreme pelvic pain, cannot walk (symphysis pubis dysfunction)\")" ] ;
           fhir:Expression.language [ fhir:value "text/cql-identifier" ] ;
           fhir:Expression.expression [ fhir:value "Should Conduct counselling on physiological symptoms 2" ]
         ]
       ] ;

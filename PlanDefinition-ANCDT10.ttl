     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCDT10" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Should Conduct hepatitis C test" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n\"Population prevalence of hepatitis C\" ≥ 2%\n*/\ndefine \"Should Conduct hepatitis C test\":\n  Config.\"Population prevalence of hepatitis C\" >= 2 '%'" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "1"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 2 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCBaseDataElements" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Patient Occupation" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "/*\n@description: The patient's occupation\n*/\ndefine \"Patient Occupation\":\n  [Patient] P\n    return (AC.Extension(P, 'occupation')).value as CodeableConcept" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "2"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 3 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "ANCDT10" ]
     ], [

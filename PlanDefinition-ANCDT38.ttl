  fhir:PlanDefinition.description [ fhir:value "IF the woman is currently in a malaria-endemic setting, or in an area where there is greater than 20% prevalence of infection with any soil-transmitted helminths, THEN she should receive preventative treatment accordingly"] ;
  fhir:PlanDefinition.useContext [
     fhir:index 0 ;
